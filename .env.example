# Public API URL shown in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public publishable key (safe for browser use). Use the local key from `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL for auth redirects (one value per environment).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional deployed staging URL used by Playwright. Leave empty for local webServer mode.
PLAYWRIGHT_BASE_URL=
